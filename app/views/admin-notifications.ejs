<%- include('partials/header') %>

<div class="page-head"><h1>系统通知</h1></div>

<div class="admin-nav">
  <a class="btn ghost sm" href="/admin">全局设置与用户</a>
  <a class="btn ghost sm" href="/admin/logs">操作日志</a>
  <a class="btn ghost sm active" href="/admin/notifications">系统通知</a>
</div>

<div class="grid-2">
  <div class="card">
    <h2 class="card-title">发布全局通知</h2>
    <form method="post" action="/admin/broadcasts" class="form">
      <div class="field">
        <label>通知标题 <span class="req">*</span></label>
        <input type="text" name="title" maxlength="80" placeholder="如：系统升级通知" required>
      </div>
      <div class="field">
        <label>通知类型</label>
        <select name="level">
          <option value="info">普通通知（信息）</option>
          <option value="warn">重要提醒（警告）</option>
          <option value="err">紧急通知（错误）</option>
        </select>
      </div>
      <div class="field">
        <label>通知内容</label>
        <textarea name="content" rows="5" placeholder="如：系统将于今晚 23:00 进行升级维护，预计持续 10 分钟，期间签到可能短暂失败。"></textarea>
      </div>
      <p class="hint">发布后将立即送达当前全部 <strong><%= userCount %></strong> 位活跃用户，并出现在其「通知」页面。</p>
      <button class="btn primary" type="submit">发布全局通知</button>
    </form>
  </div>

  <div class="card">
    <h2 class="card-title">说明</h2>
    <ul class="list">
      <li><span>系统通知类型</span><span class="muted">普通 / 重要 / 紧急</span></li>
      <li><span>接收范围</span><span class="muted">全部活跃用户</span></li>
      <li><span>用户权限</span><span class="muted">仅可查看、标为已读</span></li>
      <li><span>管理权限</span><span class="muted">仅管理员可发布 / 编辑 / 删除</span></li>
    </ul>
    <p class="hint">编辑通知内容会同步更新所有用户已收到的同一条通知；删除后该通知将从所有用户的通知列表中移除。可用于发布系统升级、维护公告、功能更新等。</p>
  </div>
</div>

<div class="card">
  <h2 class="card-title">已发布通知（<%= broadcasts.length %>）</h2>
  <% if (broadcasts.length === 0) { %>
    <p class="empty">尚未发布任何全局通知</p>
  <% } else { %>
    <% broadcasts.forEach(b => { %>
    <div class="broadcast-item">
      <div class="notif-head">
        <div>
          <span class="chip <%= b.level === 'err' ? 'err' : (b.level === 'warn' ? 'warn' : 'info') %>">
            <%= b.level === 'err' ? '紧急' : (b.level === 'warn' ? '重要' : '普通') %>
          </span>
          <strong><%= b.title %></strong>
          <span class="muted small">送达 <%= b.recipients %> 人</span>
        </div>
        <div class="notif-side">
          <span class="muted small"><%= b.created_at %><% if (b.updated_at) { %> · 已编辑<% } %></span>
        </div>
      </div>
      <% if (b.content) { %><p class="notif-content"><%= b.content %></p><% } %>
      <div class="op-group" style="margin-top:10px;">
        <details class="subform-wrap">
          <summary class="btn ghost sm">编辑</summary>
          <form method="post" action="/admin/broadcasts/<%= b.id %>" class="form subform">
            <div class="field">
              <label>标题</label>
              <input type="text" name="title" value="<%= b.title %>" maxlength="80" required>
            </div>
            <div class="field">
              <label>类型</label>
              <select name="level">
                <option value="info" <%= b.level === 'info' ? 'selected' : '' %>>普通通知</option>
                <option value="warn" <%= b.level === 'warn' ? 'selected' : '' %>>重要提醒</option>
                <option value="err" <%= b.level === 'err' ? 'selected' : '' %>>紧急通知</option>
              </select>
            </div>
            <div class="field">
              <label>内容</label>
              <textarea name="content" rows="4"><%= b.content || '' %></textarea>
            </div>
            <button class="btn primary sm" type="submit">保存修改</button>
          </form>
        </details>
        <form method="post" action="/admin/broadcasts/<%= b.id %>/delete" class="inline-form"
              onsubmit="return confirm('确定删除通知「<%= b.title %>」吗？将从所有用户的通知列表中移除。')">
          <button class="btn danger sm" type="submit">删除</button>
        </form>
      </div>
    </div>
    <% }) %>
  <% } %>
</div>

<div class="card">
  <h2 class="card-title">全部通知记录（共 <%= total %> 条）</h2>
  <p class="hint">包含全局公告、欢迎通知、授权过期与签到失败提醒等全部通知，可按需逐条或批量删除。删除全局公告的单条记录只影响该用户的副本。</p>
  <% if (notices.length === 0) { %>
    <p class="empty">暂无通知记录</p>
  <% } else { %>
  <form method="post" action="/admin/notifications/delete">
    <div class="head-actions" style="justify-content:space-between;margin-bottom:10px;">
      <label class="muted small"><input type="checkbox" id="checkAllNotif"> 全选本页</label>
      <div class="head-actions">
        <span class="muted small">共 <%= total %> 条 · 每页 <%= perPage %> 条 · 第 <%= page %>/<%= pages %> 页</span>
        <button class="btn danger sm" type="submit"
                onclick="return confirm('确定删除选中的通知吗？')">批量删除</button>
      </div>
    </div>
    <div class="table-wrap">
    <table class="table">
      <thead><tr><th class="check-col"></th><th>时间</th><th>用户</th><th>类型</th><th>标题</th><th>状态</th><th>操作</th></tr></thead>
      <tbody>
        <% notices.forEach(n => { %>
        <tr>
          <td class="check-col"><input type="checkbox" name="ids" value="<%= n.id %>" class="row-check" aria-label="选择通知"></td>
          <td class="muted nowrap"><%= n.created_at %></td>
          <td><%= n.username || ('#' + n.user_id) %></td>
          <td>
            <span class="chip <%= n.type === 'session_expired' || n.level === 'err' ? 'err' : (n.type === 'checkin_failed' || n.level === 'warn' ? 'warn' : 'info') %>">
              <%= n.type === 'session_expired' ? '授权过期' : (n.type === 'checkin_failed' ? '签到失败' : (n.level === 'warn' ? '重要' : (n.level === 'err' ? '紧急' : '系统'))) %>
            </span>
          </td>
          <td class="msg-cell"><%= n.title %></td>
          <td class="muted nowrap"><%= n.is_read ? '已读' : '未读' %></td>
          <td>
            <button type="submit" class="btn danger sm" formaction="/admin/notifications/<%= n.id %>/delete"
                    onclick="return confirm('确定删除通知「<%= n.title %>」吗？')">删除</button>
          </td>
        </tr>
        <% }) %>
      </tbody>
    </table>
    </div>
  </form>
  <% if (pages > 1) { %>
  <div class="pager">
    <% if (page > 1) { %><a class="btn ghost sm" href="/admin/notifications?page=<%= page - 1 %>">上一页</a><% } %>
    <span class="muted small">第 <%= page %> / <%= pages %> 页，共 <%= total %> 条</span>
    <% if (page < pages) { %><a class="btn ghost sm" href="/admin/notifications?page=<%= page + 1 %>">下一页</a><% } %>
  </div>
  <% } %>
  <% } %>
</div>

<script>
  (function () {
    var all = document.getElementById('checkAllNotif');
    if (!all) return;
    var boxes = Array.prototype.slice.call(document.querySelectorAll('.row-check'));
    all.addEventListener('change', function () {
      boxes.forEach(function (b) { b.checked = all.checked; });
    });
    boxes.forEach(function (b) {
      b.addEventListener('change', function () {
        all.checked = boxes.every(function (x) { return x.checked; });
      });
    });
  })();
</script>

<%- include('partials/footer') %>

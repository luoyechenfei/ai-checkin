<%- include('partials/header') %>

<div class="page-head">
  <h1>账号设置</h1>
  <span class="muted">修改登录密码，设置用于找回密码的安全问题</span>
</div>

<% if (!hasQuestions) { %>
<div class="card">
  <div class="flash err" style="margin:0;">尚未设置安全问题。为保障账号安全，请先完成下方「安全问题」设置后再使用其他功能。</div>
</div>
<% } %>

<div class="grid-2">
  <div class="card">
    <h2 class="card-title">修改密码</h2>
    <form method="post" action="/password/change" class="form">
      <div class="field">
        <label>原密码 <span class="req">*</span></label>
        <input type="password" name="old_password" required autocomplete="current-password">
      </div>
      <div class="field">
        <label>新密码 <span class="req">*</span></label>
        <input type="password" name="password" required minlength="6" autocomplete="new-password">
      </div>
      <div class="field">
        <label>确认新密码 <span class="req">*</span></label>
        <input type="password" name="password2" required minlength="6" autocomplete="new-password">
      </div>
      <p class="hint">修改成功后，其他设备上的登录状态将自动失效。</p>
      <button class="btn primary" type="submit">修改密码</button>
    </form>
  </div>

  <div class="card">
    <h2 class="card-title">安全问题（找回密码用）</h2>
    <form method="post" action="/password/questions" class="form">
      <% for (let i = 1; i <= 3; i++) { %>
      <div class="field">
        <label>问题 <%= i %> <span class="req">*</span></label>
        <input type="text" name="q<%= i %>" maxlength="100" value="<%= questions[i - 1] %>" placeholder="如：我的小学名称？" required>
      </div>
      <div class="field">
        <label>答案 <%= i %> <span class="req">*</span></label>
        <input type="text" name="a<%= i %>" maxlength="100" placeholder="答案（不区分大小写）" required autocomplete="off">
      </div>
      <% } %>
      <div class="field">
        <label>当前密码（验证身份）<span class="req">*</span></label>
        <input type="password" name="current_password" required autocomplete="current-password">
      </div>
      <p class="hint">答案以加密方式保存，不区分大小写；每次保存需完整填写 3 个问题与答案。忘记密码时答对全部 3 个问题即可重置。</p>
      <button class="btn primary" type="submit">保存安全问题</button>
    </form>
  </div>
</div>

<%- include('partials/footer') %>

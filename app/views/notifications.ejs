<%- include('partials/header') %>

<div class="page-head">
  <h1>通知</h1>
  <form method="post" action="/notifications/read-all" class="inline-form">
    <button class="btn ghost sm" type="submit">全部标为已读</button>
  </form>
</div>

<% if (list.length === 0) { %>
  <div class="card"><p class="empty">暂无通知</p></div>
<% } %>

<% list.forEach(n => { %>
<div class="card notif-card <%= n.is_read ? '' : 'unread' %>">
  <div class="notif-head">
    <div>
      <span class="chip <%= n.type === 'session_expired' || n.level === 'err' ? 'err' : (n.type === 'checkin_failed' || n.level === 'warn' ? 'warn' : 'info') %>">
        <%= n.type === 'session_expired' ? '授权过期' : (n.type === 'checkin_failed' ? '签到失败' : (n.level === 'err' ? '紧急通知' : (n.level === 'warn' ? '重要通知' : '系统'))) %>
      </span>
      <strong><%= n.title %></strong>
    </div>
    <div class="notif-side">
      <span class="muted small"><%= n.created_at %></span>
      <% if (!n.is_read) { %>
      <form method="post" action="/notifications/<%= n.id %>/read" class="inline-form">
        <button class="btn ghost sm" type="submit">标为已读</button>
      </form>
      <% } %>
      <% if (user.isAdmin) { %>
      <form method="post" action="/admin/notifications/<%= n.id %>/delete" class="inline-form"
            onsubmit="return confirm('确定删除这条通知吗？')">
        <input type="hidden" name="from" value="list">
        <button class="btn danger sm" type="submit">删除</button>
      </form>
      <% } %>
    </div>
  </div>
  <% if (n.content) { %><p class="notif-content"><%= n.content %></p><% } %>
</div>
<% }) %>

<%- include('partials/footer') %>

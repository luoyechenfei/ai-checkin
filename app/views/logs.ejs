<%- include('partials/header') %>

<div class="page-head">
  <h1>签到记录</h1>
  <form method="get" action="/logs" class="filter-form">
    <select name="platform">
      <option value="">全部平台</option>
      <% platforms.forEach(p => { %>
        <option value="<%= p.id %>" <%= filterPlatform === p.id ? 'selected' : '' %>><%= p.name %></option>
      <% }) %>
    </select>
    <select name="status">
      <option value="">全部结果</option>
      <option value="ok" <%= filterStatus === 'ok' ? 'selected' : '' %>>成功</option>
      <option value="fail" <%= filterStatus === 'fail' ? 'selected' : '' %>>失败</option>
    </select>
    <button class="btn ghost sm" type="submit">筛选</button>
  </form>
</div>

<div class="card">
  <% if (logs.length === 0) { %>
    <p class="empty">暂无记录</p>
  <% } else { %>
  <form method="post" action="/logs/delete" id="logsForm">
    <div class="bulk-bar">
      <label class="check-line"><input type="checkbox" id="checkAll"> 全选本页</label>
      <span class="muted small">共 <%= total %> 条 · 每页 <%= perPage %> 条 · 第 <%= page %>/<%= pages %> 页</span>
      <button class="btn danger sm" type="submit"
              onclick="return confirm('确定删除选中的签到记录吗？删除后不可恢复。')">批量删除</button>
    </div>
    <div class="table-wrap">
    <table class="table fixed logs-table">
      <colgroup>
        <col class="col-check">
        <col class="col-time">
        <col class="col-platform">
        <col class="col-account">
        <col class="col-result">
        <col class="col-points">
        <col class="col-message">
        <col class="col-actions">
      </colgroup>
      <thead><tr><th class="check-col"></th><th class="ta-l">时间</th><th class="ta-c">平台</th><th class="ta-c">账号</th><th class="ta-c">结果</th><th class="ta-c">积分</th><th class="ta-l">消息</th><th class="col-actions">操作</th></tr></thead>
      <tbody>
        <% logs.forEach(l => { %>
        <tr>
          <td class="check-col"><input type="checkbox" name="ids" value="<%= l.id %>" class="row-check" aria-label="选择记录"></td>
          <td class="muted nowrap ta-l"><%= l.created_at %></td>
          <td class="ta-c"><span class="pill"><%= l.platformName %></span></td>
          <td class="ta-c"><%= l.account_name || '-' %></td>
          <td class="cell-result ta-c"><span class="chip <%= l.success ? 'ok' : 'err' %>"><%= l.success ? '成功' : '失败' %></span></td>
          <td class="nowrap ta-c"><%= l.points > 0 ? '+' + l.points : (l.success ? '0' : '-') %></td>
          <td class="msg-cell ta-l"><%= l.message || '' %></td>
          <td class="col-actions">
            <button type="submit" class="btn danger sm" formaction="/logs/<%= l.id %>/delete"
                    onclick="return confirm('确定删除这条记录吗？')">删除</button>
          </td>
        </tr>
        <% }) %>
      </tbody>
    </table>
    </div>
  </form>
  <% if (pages > 1) { %>
  <div class="pager">
    <% if (page > 1) { %><a class="btn ghost sm" href="/logs?page=<%= page - 1 %><%= queryBase %>">上一页</a><% } %>
    <span class="muted small">第 <%= page %> / <%= pages %> 页，共 <%= total %> 条</span>
    <% if (page < pages) { %><a class="btn ghost sm" href="/logs?page=<%= page + 1 %><%= queryBase %>">下一页</a><% } %>
  </div>
  <% } %>
  <% } %>
</div>

<script>
  (function () {
    var all = document.getElementById('checkAll');
    if (!all) return;
    var boxes = Array.prototype.slice.call(document.querySelectorAll('.row-check'));
    all.addEventListener('change', function () {
      boxes.forEach(function (b) { b.checked = all.checked; });
    });
    boxes.forEach(function (b) {
      b.addEventListener('change', function () {
        all.checked = boxes.every(function (x) { return x.checked; });
      });
    });
  })();
</script>

<%- include('partials/footer') %>

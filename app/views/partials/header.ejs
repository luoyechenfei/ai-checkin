<!DOCTYPE html>
<html lang="zh-CN" data-theme-mode="<%= themeMode || 'light' %>" data-user="<%= user ? '1' : '0' %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> - <%= siteName %></title>
  <script>
    (function () {
      var html = document.documentElement;
      var mode = html.getAttribute('data-theme-mode') || 'light';
      var isUser = html.getAttribute('data-user') === '1';
      if (!isUser) {
        try { var saved = localStorage.getItem('aic-theme'); if (saved) mode = saved; } catch (e) {}
      }
      function effective(m) {
        if (m === 'dark' || m === 'light') return m;
        return (window.matchMedia && matchMedia('(prefers-color-scheme: dark)').matches) ? 'dark' : 'light';
      }
      html.setAttribute('data-theme-mode', mode);
      html.setAttribute('data-theme', effective(mode));
      window.__aicTheme = { mode: mode, isUser: isUser, effective: effective };
    })();
  </script>
  <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Crect width='100' height='100' rx='6' fill='%235b5bd6'/%3E%3Cpath d='M28 52 L44 68 L74 36' stroke='%23ffffff' stroke-width='10' fill='none' stroke-linecap='round' stroke-linejoin='round'/%3E%3C/svg%3E">
  <link rel="stylesheet" href="/public/style.css?v=<%= assetVersion %>">
</head>
<%
  // 页面容器分档：宽表页 1280px / 管理页与列表页 1120px / 表单页 860px
  const wideTitles = ['仪表盘', '平台账号', '签到记录'];
  const midTitles = ['通知', '管理后台', '操作日志', '系统通知'];
  const pageClass = wideTitles.includes(title) ? 'wide-page'
    : (midTitles.includes(title) ? 'mid-page' : (title === '账号设置' ? 'narrow-page' : ''));
%>
<body class="<%= (title === '仪表盘' ? 'dashboard ' : '') + pageClass %>">
<% if (user) { %>
<header class="topbar">
  <div class="topbar-inner">
    <a class="brand" href="/dashboard"><span class="brand-dot" aria-hidden="true">✓</span><span class="brand-word"><%= siteName %><small>CHECK-IN LEDGER</small></span></a>
    <nav class="nav">
      <a href="/dashboard" class="<%= title === '仪表盘' ? 'active' : '' %>">仪表盘</a>
      <a href="/accounts" class="<%= title === '平台账号' ? 'active' : '' %>">平台账号</a>
      <a href="/logs" class="<%= title === '签到记录' ? 'active' : '' %>">签到记录</a>
      <a href="/notifications" class="<%= title === '通知' ? 'active' : '' %>">通知<% if (unread > 0) { %><span class="badge"><%= unread %></span><% } %></a>
      <a href="/password" class="<%= title === '账号设置' ? 'active' : '' %>">设置</a>
      <% if (user.isAdmin) { %><a href="/admin" class="<%= ['管理后台', '操作日志', '系统通知'].includes(title) ? 'active' : '' %>">管理</a><% } %>
    </nav>
    <div class="nav-tools">
      <span class="nav-user"><%= user.username %></span>
      <div class="theme-seg" role="group" aria-label="主题模式">
        <button type="button" class="theme-seg-btn" data-mode="light" aria-label="浅色主题" aria-pressed="false" title="浅色">
          <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.35" stroke-linecap="round" aria-hidden="true"><circle cx="8" cy="8" r="3.1"/><path d="M8 1.1v1.9M8 13v1.9M1.1 8h1.9M13 8h1.9M3.1 3.1l1.3 1.3M11.6 11.6l1.3 1.3M12.9 3.1l-1.3 1.3M4.4 11.6l-1.3 1.3"/></svg>
        </button>
        <button type="button" class="theme-seg-btn" data-mode="dark" aria-label="深色主题" aria-pressed="false" title="深色">
          <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.35" stroke-linejoin="round" aria-hidden="true"><path d="M13.3 9.7A5.6 5.6 0 0 1 6.3 2.7 5.6 5.6 0 1 0 13.3 9.7Z"/></svg>
        </button>
        <button type="button" class="theme-seg-btn" data-mode="auto" aria-label="跟随系统主题" aria-pressed="false" title="跟随系统">
          <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.35" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="1.9" y="2.6" width="12.2" height="8.4" rx="1.2"/><path d="M5.2 13.6h5.6M8 11v2.6"/></svg>
        </button>
      </div>
      <form method="post" action="/logout" class="inline-form"><button class="btn ghost sm" type="submit">退出</button></form>
    </div>
  </div>
</header>
<% } else { %>
<div class="guest-bar">
  <a class="brand" href="/login"><span class="brand-dot" aria-hidden="true">✓</span><span class="brand-word"><%= siteName %><small>CHECK-IN LEDGER</small></span></a>
  <div class="theme-corner">
    <div class="theme-seg" role="group" aria-label="主题模式">
      <button type="button" class="theme-seg-btn" data-mode="light" aria-label="浅色主题" aria-pressed="false" title="浅色">
        <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.35" stroke-linecap="round" aria-hidden="true"><circle cx="8" cy="8" r="3.1"/><path d="M8 1.1v1.9M8 13v1.9M1.1 8h1.9M13 8h1.9M3.1 3.1l1.3 1.3M11.6 11.6l1.3 1.3M12.9 3.1l-1.3 1.3M4.4 11.6l-1.3 1.3"/></svg>
      </button>
      <button type="button" class="theme-seg-btn" data-mode="dark" aria-label="深色主题" aria-pressed="false" title="深色">
        <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.35" stroke-linejoin="round" aria-hidden="true"><path d="M13.3 9.7A5.6 5.6 0 0 1 6.3 2.7 5.6 5.6 0 1 0 13.3 9.7Z"/></svg>
      </button>
      <button type="button" class="theme-seg-btn" data-mode="auto" aria-label="跟随系统主题" aria-pressed="false" title="跟随系统">
        <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.35" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="1.9" y="2.6" width="12.2" height="8.4" rx="1.2"/><path d="M5.2 13.6h5.6M8 11v2.6"/></svg>
      </button>
    </div>
  </div>
</div>
<% } %>
<main class="container">
<% if (msg) { %><div class="flash <%= msgType %>"><%= msg %></div><% } %>

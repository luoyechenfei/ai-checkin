<!DOCTYPE html>
<html lang="zh-CN" data-theme-mode="<%= themeMode || 'auto' %>" data-user="<%= user ? '1' : '0' %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> - <%= siteName %></title>
  <script>
    (function () {
      var html = document.documentElement;
      var mode = html.getAttribute('data-theme-mode') || 'auto';
      var isUser = html.getAttribute('data-user') === '1';
      if (!isUser) {
        try { var saved = localStorage.getItem('aic-theme'); if (saved) mode = saved; } catch (e) {}
      }
      function effective(m) {
        if (m === 'dark' || m === 'light') return m;
        return (window.matchMedia && matchMedia('(prefers-color-scheme: dark)').matches) ? 'dark' : 'light';
      }
      html.setAttribute('data-theme-mode', mode);
      html.setAttribute('data-theme', effective(mode));
      window.__aicTheme = { mode: mode, isUser: isUser, effective: effective };
    })();
  </script>
  <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Crect width='100' height='100' rx='22' fill='%234f6ef7'/%3E%3Cpath d='M28 52 L44 68 L74 36' stroke='white' stroke-width='10' fill='none' stroke-linecap='round' stroke-linejoin='round'/%3E%3C/svg%3E">
  <link rel="stylesheet" href="/public/style.css?v=<%= assetVersion %>">
</head>
<body>
<% if (user) { %>
<header class="topbar">
  <div class="topbar-inner">
    <a class="brand" href="/dashboard"><span class="brand-dot">✓</span><%= siteName %></a>
    <nav class="nav">
      <a href="/dashboard" class="<%= title === '仪表盘' ? 'active' : '' %>">仪表盘</a>
      <a href="/accounts" class="<%= title === '平台账号' ? 'active' : '' %>">平台账号</a>
      <a href="/logs" class="<%= title === '签到记录' ? 'active' : '' %>">签到记录</a>
      <a href="/notifications" class="<%= title === '通知' ? 'active' : '' %>">通知<% if (unread > 0) { %><span class="badge"><%= unread %></span><% } %></a>
      <% if (user.isAdmin) { %><a href="/admin" class="<%= ['管理后台', '操作日志', '系统通知'].includes(title) ? 'active' : '' %>">管理</a><% } %>
      <span class="nav-user"><%= user.username %></span>
      <label class="theme-select-wrap" title="主题模式">
        <select id="themeSelect" class="theme-select" aria-label="主题模式">
          <option value="auto">跟随系统</option>
          <option value="light">浅色</option>
          <option value="dark">深色</option>
        </select>
      </label>
      <form method="post" action="/logout" class="inline-form"><button class="btn ghost sm" type="submit">退出</button></form>
    </nav>
  </div>
</header>
<% } else { %>
<div class="theme-corner">
  <select id="themeSelect" class="theme-select" aria-label="主题模式">
    <option value="auto">跟随系统</option>
    <option value="light">浅色</option>
    <option value="dark">深色</option>
  </select>
</div>
<% } %>
<main class="container">
<% if (msg) { %><div class="flash <%= msgType %>"><%= msg %></div><% } %>

<%# Trae OAuth 扫码授权区块（自动续期） %>
<div class="trae-oauth">
  <div class="oauth-title">OAuth 扫码授权（推荐，可自动续期）</div>
  <button type="button" class="btn ghost sm oauth-gen">生成 Trae 授权链接</button>
  <div class="oauth-step2" hidden>
    <p class="hint oauth-hint"></p>
    <a class="oauth-link btn primary sm" href="#" target="_blank" rel="noopener">打开 Trae 授权页</a>
    <div class="oauth-paste-area" hidden>
      <textarea class="oauth-callback" rows="2" placeholder="粘贴登录后的完整回调链接（http://127.0.0.1:39393/authorize?...）"></textarea>
      <button type="button" class="btn primary sm oauth-parse">解析回调</button>
    </div>
  </div>
  <div class="oauth-result"></div>
  <input type="hidden" name="f_refresh_token">
  <input type="hidden" name="f_machine_id">
  <input type="hidden" name="f_device_public_key">
  <input type="hidden" name="f_device_private_key">
  <input type="hidden" name="f_uid">
  <input type="hidden" name="f_name">
  <input type="hidden" name="f_token_expires_at">
  <div class="field">
    <label class="check-line">
      <input type="checkbox" name="auto_renew" value="1"> 启用自动续期（Token 到期前系统自动刷新，需通过上方 OAuth 授权）
    </label>
  </div>
</div>
